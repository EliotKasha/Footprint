# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Unity crash-recovery scene backups (after the meta rule so it wins)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# IDE / solution files (regenerated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-buildid.txt
sysinfo.txt

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python (CV / analysis code)
__pycache__/
*.pyc
.venv/
venv/
.env
